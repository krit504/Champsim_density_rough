//update live score
void set_live_score(uint64_t ip, PACKET *blk){
	if(sampler.find(ip)->second[0]<=256) blk->live_score = 0;
	else if(sampler.find(ip)->second[0]<=512) blk->live_score = 1;
	else if(sampler.find(ip)->second[0]<=768) blk->live_score = 2;
	else blk->live_score = 3;
	if(blk->live_score<=THRESHOLD) blk->is_bypass=1;
	else blk->is_bypass=0;

}

void set_live_score(uint64_t ip, BLOCK *blk){
	if(sampler.find(ip)->second[0]<=10) blk->live_score = 0;
	else if(sampler.find(ip)->second[0]<=50) blk->live_score = 1;
	else if(sampler.find(ip)->second[0]<=150) blk->live_score = 2;
	else blk->live_score = 3;
	if(blk->live_score<=THRESHOLD) blk->is_bypass=1;
	else blk->is_bypass=0;


}

void find_live_score(){
	cycle_count++;
	int rq_occupancy = 0, mshr_occupancy = 0;
	double tmp_live_score =0;
	for(int i=0;i<uncore.LLC.MSHR.occupancy;i++){
		tmp_live_score += uncore.LLC.MSHR.entry[i].live_score;
		mshr_occupancy++;
		if(uncore.LLC.MSHR.entry[i].type==LOAD){
			total_occupancy++;
			if(uncore.LLC.MSHR.entry[i].live_score>THRESHOLD) rq_occupancy++;
		}
	}
	
	int wq_occupancy = 0;
	for(int i=0;i<uncore.LLC.WQ.occupancy;i++){
		tmp_live_score += uncore.LLC.WQ.entry[i].live_score;
		if(uncore.LLC.WQ.entry[i].live_score>THRESHOLD) wq_occupancy++; //TODO motivation count of ls > threshold
	}
	no_of_block += (rq_occupancy + wq_occupancy);
	total_occupancy += uncore.LLC.WQ.occupancy;
	//cout<<tmp_live_score<<"\t"<<(uncore.LLC.WQ.occupancy+mshr_occupancy)<<endl;
	if(tmp_live_score && (uncore.LLC.WQ.occupancy+mshr_occupancy)) tmp_live_score /= (uncore.LLC.WQ.occupancy+mshr_occupancy);
	//cout<<tmp_live_score<<endl;
	avg_live_score += tmp_live_score;
}



bool write_congestion(int thr){
	int rq_occupancy = 0;
	for(int i=0;i<uncore.LLC.MSHR.occupancy;i++){
		if(uncore.LLC.MSHR.entry[i].type==LOAD){
			if(uncore.LLC.MSHR.entry[i].live_score>THRESHOLD) rq_occupancy++;
		}
	}
	
	int wq_occupancy = 0;
	for(int i=0;i<uncore.LLC.WQ.occupancy;i++){
		if(uncore.LLC.WQ.entry[i].live_score>THRESHOLD) wq_occupancy++; //TODO motivation count of ls > threshold
	}
	
	if((rq_occupancy + wq_occupancy) < LIVE_WRITE_THR) return true;
	
	return false;
}


bool l2c_write_congestion(){
	int rq_occupancy = 0;
	for(int i=0;i<uncore.LLC.MSHR.occupancy;i++){
		if(uncore.LLC.MSHR.entry[i].type==LOAD) rq_occupancy++;
	}
	int wq_occupancy = uncore.LLC.WQ.occupancy;
	if((rq_occupancy + wq_occupancy) < WRITE_THR) return true;
	
	return false;
}


