uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    
    int way = lru_victim(cpu, instr_id, set, current_set, ip, full_addr, type); 
    if (L2C_WRITE_MERGE && sampler.find(block[set][way].ip)!=sampler.end()){
	    while(block[set][way].valid && get_lru(block[set][way].ip)){
			lru_update(set, way);
