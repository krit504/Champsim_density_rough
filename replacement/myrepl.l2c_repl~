void set_threshold(uint32_t cpu, PACKET *blk){
	if(warmup_complete[cpu]) find_live_score();
	int numretire = 0;
	for(int i=0;i<NUM_CPUS;i++){
		numretire+= ooo_cpu[i].num_retired;
	}
	if(warmup_complete[cpu] && (numretire - prev_num_retire) >= CYCLE_WINDOW){
		double avg_cycle_livescore = avg_live_score/cycle_count;
		double avg_total_occupancy = total_occupancy/(numretire - prev_num_retire);
		double avg_no_of_block = no_of_block/(numretire - prev_num_retire);
		
		THRESHOLD = avg_cycle_livescore;
		//cout<<"avg_cycle_livescore: "<<avg_cycle_livescore<<"\tPercentage of blocks with LS greater than THreshold: "<<(avg_no_of_block*100)/avg_total_occupancy<<endl;
		
		LS_GT = (avg_no_of_block*100)/(avg_total_occupancy*LLC_BANK);
		
		prev_num_retire = numretire;
		avg_live_score = 0;
		no_of_block = 0;
		total_occupancy = 0;
		cycle_count=0;
	}
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, PACKET *blk, uint64_t victim_addr, uint32_t type, uint8_t hit)
{

	if(WRITE_BYPASS) set_threshold(cpu, blk);	
	blk->ls_gt = LS_GT;
	
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && blk->ip)
        assert(0);

    // uncomment this line to see the LLC accesses
    // cout << "CPU: " << cpu << "  LLC " << setw(9) << TYPE_NAME << " set: " << setw(5) << set << " way: " << setw(2) << way;
    // cout << hex << " paddr: " << setw(12) << paddr << " ip: " << setw(8) << ip << " victim_addr: " << victim_addr << dec << endl;

    // baseline LRU
    if (hit && (type == WRITEBACK)) // writeback hit does not update LRU state
        return;

    //sampler update for victim block
    
    if (way != L2C_WAY && sampler.find(block[set][way].ip)!=sampler.end()){		//block[set][way].ip = victim ip;
    
    // update sampler in hit only
	if(is_it_sampled(set)){
	
		set_live_score(block[set][way].ip, &block[set][way]);
		
		(sampler.find(block[set][way].ip)->second[0])-=2;
	}
	
    }
    
    
    //sampler update for upcoming block
    if (sampler.find(blk->ip)!=sampler.end()){	
    	
    // update sampler in hit only
	if(is_it_sampled(set)){
	
		(sampler.find(blk->ip)->second[0])+=10;
		
		if(sampler.find(blk->ip)->second[0]>1024) sampler.find(blk->ip)->second[0]=1024;
		
		if(blk->carry_indicator) {
			/*cnt++;
			if(cnt%100==0) cout<<cnt<<" ";*/
			(sampler.find(blk->ip)->second[1])+=10;
			if(sampler.find(blk->ip)->second[1]>1024) sampler.find(blk->ip)->second[1]=1024;
			blk->carry_indicator = 0;
		}
		else
		{
			sampler.find(blk->ip)->second[1]-=2;
			/*cnt++;
			if(cnt%100==0) cout<<cnt<<" ";*/
			
		}
		
		if(blk->l2c_wm) {
			/*cnt++;
			if(cnt%100==0) cout<<cnt<<" ";*/
			(sampler.find(blk->ip)->second[2])+=10;
			if(sampler.find(blk->ip)->second[2]>100) sampler.find(blk->ip)->second[2]=100;
			blk->l2c_wm=0;
		}
		else
		{
			sampler.find(blk->ip)->second[2]-=2;
			/*cnt++;
			if(cnt%100==0) cout<<cnt<<" ";*/
			
		}	
	}
	else{
		set_live_score(blk->ip, blk);
		
		if(RUN_AHEAD) set_run_ahead_bit(blk->ip, blk);
	}
	
    }
    else {
    
    	if(is_it_sampled(set)) {
    		vector<int> arr;
    		arr.push_back(0);
    		//arr.push_back(blk->carry_indicator);
    		arr.push_back(0);
    		arr.push_back(0);
    		if(sampler.size()==SAMPLER_SIZE) sampler.erase(sampler.begin());
    		
    		sampler.insert(pair<uint64_t, vector<int>>(blk->ip, arr));
    		
    	}
        // sanity check
		//check if the set is in rand_set or not , if yes update_sampler else do nothing//decrement
	
    }
    if(!full_addr && blk->run_ahead && warmup_complete[cpu]) {
    	cnt++;
    	if(uncore.LLC.lower_level->RQ.occupancy < uncore.LLC.lower_level->RQ.SIZE) cnt_run_ahead++;
    }
    
    if(way == L2C_WAY) return;
    else return lru_update(set, way);
    

}

